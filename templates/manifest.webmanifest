{
  "name": "ARCHIOSK",
  "short_name": "ARCHIOSK",
  "description": "Governed, evidence-backed answers from your project documents.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0b1f28",
  "theme_color": "#0b1f28",
  "icons": [
    {
      "src": "/static/icons/app-icon-192.png?v={{ static_version }}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icons/app-icon-512.png?v={{ static_version }}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icons/app-icon-maskable-512.png?v={{ static_version }}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/static/app-icon.svg?v={{ static_version }}",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
