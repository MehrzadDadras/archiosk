# Copy to .env and fill in real values. Never commit the real .env file.

# Flask
FLASK_ENV=development          # development | production | testing
FLASK_SECRET_KEY=              # generate with: python -c "import secrets; print(secrets.token_hex(32))"
PORT=5000

# Anthropic / B-Hive classification
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_TIMEOUT_SECONDS=30      # per-batch classification timeout before falling back to rule-based
ANTHROPIC_CLASSIFY_BUDGET_SECONDS=90  # overall classify-stage ceiling for large documents; keep below GUNICORN_TIMEOUT
ANTHROPIC_CONSISTENCY_TIMEOUT_SECONDS=25  # cross-requirement contradiction check; adds to the same request as classify -- keep (classify budget + this) below GUNICORN_TIMEOUT
AI_CALLS_DISABLED=false  # emergency kill switch (CLAUDE-P27-B) -- true forces both stages into their existing no-key fallback (rule-based classify, skipped consistency check); no restart-time-only effect, read fresh by every new BHiveParser instance

# Storage
# Leave both blank to use config.py's own default (an absolute path built
# from BASE_DIR) -- that default is cwd-independent by design (see
# config.py's load_dotenv comment). A *relative* path here (e.g.
# "sqlite:///instance/bhive.db") only works if the process's cwd happens
# to equal the repo root, and breaks under Werkzeug's reloader or a
# gunicorn WorkingDirectory that isn't set to match. If you do override
# these, use an absolute path.
DATABASE_URL=
REGISTRY_STORE_PATH=

# Uploads
# CLAUDE-P40-VW8-QA (Project-Creation Upload-Capacity Correction): 25MB
# was too small for a real procurement RFP/RFQ/spec PDF with exhibits -
# a product-owner walkthrough hit the raw Werkzeug 413 page uploading a
# real document. Raised to 60MB - safely inside this app's synchronous,
# in-memory (services/ingestion.py's `file_storage.read()`), single-
# request processing model (no chunked/streaming upload, no background
# job queue) and its existing ANTHROPIC_CLASSIFY_BUDGET_SECONDS=90 /
# GUNICORN_TIMEOUT=150 budgets - comfortable for real text-based RFP/
# spec/report PDFs and DOCX files, including exhibits. A full scanned
# drawing package (100MB+) is NOT safely supported by this synchronous
# architecture yet - that remains a recorded, deliberately deferred
# limitation requiring streaming/chunked upload or background
# processing, not something to raise this number further to paper over.
MAX_UPLOAD_MB=60   # if you raise this, also update client_max_body_size in deploy/nginx.conf (static, not env-driven)

# Static assets
STATIC_VERSION=4   # bump on every main.css/dashboard.js change -- nginx caches /static/ for 30 days as immutable
                    # (2: login card restyle -- turquoise .gateway-card-compact, gold sign-in button)
                    # (3: midnight-blue page background + frosted-glass .gateway-card-compact)
                    # (4: .help-desk section heading style)

# Web UI login gate: users are provisioned via the DB, not env vars.
# There is no self-registration route -- create accounts with:
#   python tools/create_credentials.py --username admin --role admin
#   python tools/create_credentials.py --username jdoe --role read_only --email jdoe@example.com

# Password reset email (services/email.py / services/password_reset.py).
# Optional -- leave SMTP_HOST blank to run without email entirely; in a
# development/testing config (FLASK_ENV != production) a blank SMTP_HOST
# falls back to logging the reset link instead of sending it, marked
# "DEV-ONLY" in the server log. A blank SMTP_HOST in production means no
# reset link is ever generated anywhere - that's a deliberate fail-closed
# default, not a bug to work around by relaxing the dev-fallback gate.
#
# Two mutually exclusive transports -- set exactly one, not both:
#   - STARTTLS (typical port 587): SMTP_USE_TLS=true, SMTP_USE_SSL=false
#   - Implicit TLS (typical port 465): SMTP_USE_SSL=true, SMTP_USE_TLS=false
#   - Unencrypted (rare, only if your provider truly has no TLS): both false
#
# Safe local testing without any real credentials or a real inbox: run a
# local mail-catcher (e.g. Mailpit - https://github.com/axllent/mailpit,
# a single binary, `mailpit` then it listens on SMTP :1025 / web UI
# :8025) and point SMTP_HOST at it -- no code change needed, send_email()
# already speaks plain SMTP to any real server:
#   SMTP_HOST=127.0.0.1
#   SMTP_PORT=1025
#   SMTP_USE_TLS=false
#   SMTP_USE_SSL=false
# Every "sent" email lands in Mailpit's web UI instead of a real inbox --
# safe to test the full delivery path with zero real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=                          # falls back to SMTP_USERNAME if blank
SMTP_USE_TLS=true                   # STARTTLS (port 587) -- see the two-transport note above
SMTP_USE_SSL=false                  # implicit TLS (port 465) -- mutually exclusive with SMTP_USE_TLS

# Gunicorn (production only -- read via deploy/gunicorn.conf.py, loaded through
# deploy/gunicorn.service's EnvironmentFile; unused by `flask run`/`python app.py`)
GUNICORN_BIND=127.0.0.1:8000            # must match deploy/nginx.conf's upstream
GUNICORN_WORKERS=                       # default: (2 x cpu cores) + 1
GUNICORN_WORKER_CLASS=gthread           # sync workers handle one request at a time; nothing here is CPU-bound
GUNICORN_THREADS=4                      # concurrent requests per worker under gthread
GUNICORN_TIMEOUT=150                    # keep in sync with deploy/nginx.conf's proxy_read_timeout
GUNICORN_WORKER_TMP_DIR=/dev/shm        # tmpfs avoids a slow-disk false-positive worker-timeout kill
GUNICORN_LOG_LEVEL=info
