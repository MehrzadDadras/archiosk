# Secrets — never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Local data / instance folder (sqlite db, registry JSON store)
instance/
*.db
*.sqlite3

# Backup archives (tools/backup_data.py) -- real user/project data, never committed
backups/

# Logs
*.log

# OS / editor
.DS_Store
.vscode/
.idea/

# Node (if frontend tooling is added later)
node_modules/

# Generated static-preview build output (regenerate via tools/static_preview/)
tools/static_preview/build/

# Claude Code local, machine-specific state - never the shared project
# config (.claude/skills/, a future .claude/settings.json belong in git;
# this doesn't)
.claude/settings.local.json

# tests/fixtures/nreocrc/ingest_nreocrc_lab.py and its _002 sibling both label
# their output "regenerable, not committed" - but nothing enforced it, so 45
# generated workspace/governance files sat untracked where a `git add -A` would
# have swept them into a commit as if they were fixtures.
tests/fixtures/nreocrc/_lab_instance_scratch*/

# Derived rasters of the 5 Nipigon source PDFs (tools/render_nipigon_assets.py).
# The PDFs remain authoritative; these are regenerable bytes.
static/nipigon/
